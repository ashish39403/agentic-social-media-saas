# Application
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Neon development branch only. Never place production credentials in local files.
# Runtime URL must be pooled; Alembic URL must be direct/unpooled.
DATABASE_URL=postgresql+asyncpg://user:password@development-pooler.example.neon.tech/database?ssl=require
DATABASE_URL_UNPOOLED=postgresql+asyncpg://user:password@development.example.neon.tech/database?ssl=require

# Local/private Redis used by Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Browser-to-backend path through Nginx in the composed environment
NEXT_PUBLIC_API_BASE_URL=/api/v1
